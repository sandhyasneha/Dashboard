# Runs ON the InterServer box. Reads SQL Server locally, pushes to Supabase over HTTPS.
# Use a READ-ONLY login for TruckTaxPro; the merge into TruckTaxEmailCenterDb needs INSERT there.
MSSQL_SERVER=localhost
# On the InterServer box: local = read through shared memory (TCP/IP stays off). See the KB, The daily sync on the server.
MSSQL_MODE=local
MSSQL_PORT=1433
MSSQL_USER=sync_user
MSSQL_PASSWORD=
MSSQL_PROD_DB=TruckTaxPro
MSSQL_EMAILCENTER_DB=TruckTaxEmailCenterDb
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=


# Which vehicle types count as a vehicle on a return: 1 = Taxable, 2 = Suspended. Credits (3 to 6) and prior-year (7) are left out.
VEHICLE_TYPE_IDS=1,2

# Optional: the company (business) name on each return, for the Customers list. One SELECT returning FilingId and Company.
# Leave empty until the column is known and sync_user may read it. Example (the real table and column names may differ):
# COMPANY_QUERY=SELECT r.FilingId, r.BusinessName AS Company FROM [TruckTaxPro].dbo.Form2290ReturnMaster r WHERE ISNULL(r.IsDeleted,0) = 0
COMPANY_QUERY=
