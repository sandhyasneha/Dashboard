# Runs ON the InterServer box. Reads SQL Server locally, pushes to Supabase over HTTPS.
# Use a READ-ONLY login for TruckTaxPro; the merge into TruckTaxEmailCenterDb needs INSERT there.
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_USER=sync_user
MSSQL_PASSWORD=
MSSQL_PROD_DB=TruckTaxPro
MSSQL_EMAILCENTER_DB=TruckTaxEmailCenterDb
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# First run: also push the 6,595 EmailMarketingCustomers into the app as leads (source=historical). Set to false afterwards.
IMPORT_HISTORICAL_CUSTOMERS=true
