# Supabase (this app's project)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=            # from Resend > Webhooks (svix signing secret, starts with whsec_)
EMAIL_FROM="TruckTaxPro <hello@mail.trucktaxpro.com>"
EMAIL_REPLY_TO=support@trucktaxpro.com

# App
ADMIN_EMAILS=admin@trucktaxpro.com    # comma-separated; only these may sign in
NEXT_PUBLIC_APP_URL=https://campaigns.trucktaxpro.com
CRON_SECRET=                      # Vercel sets Authorization: Bearer <CRON_SECRET> on cron calls
UNSUBSCRIBE_SECRET=               # any long random string

# Optional extra: a webhook trucktaxpro.com can call the instant someone registers/files
# (the hourly sync/ script covers this anyway).
TTP_WEBHOOK_SECRET=

# Optional: the "why you are receiving this" line in every email footer
EMAIL_FOOTER_REASON=

# AI writer (Write with AI in the campaign builder). Create a key at console.anthropic.com
ANTHROPIC_API_KEY=

# Email footer: optional social icons (shown only when a link is set) and phone override
SOCIAL_X_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_FACEBOOK_URL=
COMPANY_PHONE=
